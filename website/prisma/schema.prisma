// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma" // Ensure this path is correct for your Next.js project structure
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique // User's unique email for login
  hashedPassword String // Store hashed passwords (e.g., bcrypt), never plain text
  name           String? // Optional user's display name
  emailVerified  Boolean          @default(false) // For email verification flow
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt // Automatically updated on record change
  currentTier    SubscriptionTier @default(FREE) // Link to their current subscription tier

  // Relations: A user can have many API keys and many tunnels
  apiKey  APIKey?
  tunnels Tunnel[]
}

model APIKey {
  id         String    @id @default(uuid())
  keyPrefix  String    @unique
  keyHash    String    @unique // Store a hash of the API key (the actual key is given to the user once)
  name       String? // User-defined name for the key (e.g., "My Laptop Key", "CI/CD Key")
  isActive   Boolean   @default(true) // Allows users to enable/disable/revoke keys
  createdAt  DateTime  @default(now())
  expiresAt  DateTime? // Optional: Set an expiration date for the key
  lastUsedAt DateTime? // To track when the key was last used for auditing/cleanup

  userId String @unique // Foreign key to link this API key to a specific user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // If user is deleted, their keys are deleted

  @@unique([userId, keyHash]) // Ensures a user doesn't have duplicate key hashes
}

model Tunnel {
  id           String    @id @default(uuid())
  clientId     String    @unique // The unique ID generated by the Go client (e.g., "fee4722d3ca1")
  subdomain    String    @unique // The unique subdomain generated for this tunnel (e.g., "tunnel-fee4722d3ca1")
  publicUrl    String    @unique // The full public URL (e.g., "https://tunnel-fee4722d3ca1.bifrost.prajyot.dev")
  localPort    Int // The local port on the user's machine that this tunnel forwards to
  isActive     Boolean   @default(true) // True if the Go client is currently connected and the tunnel is active
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt // Automatically updated on record change (e.g., status changes)
  lastActivity DateTime? // Timestamp of the last HTTP request that passed through this tunnel

  userId String // Foreign key to link this tunnel to a specific user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // If user is deleted, their tunnels are deleted
}

model EarlySignup {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
